{
  "name": "coordinate-format",
  "version": "1.0.0",
  "description": "format decimal lat/lon coords into degrees/minutes/seconds formats (like DMS).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "directories": {
    "doc": "doc"
  },
  "scripts": {
    "test": "vitest",
    "build": "tsdown",
    "prepack": "npm run build"
  },
  "repository": {
    "url": "git+https://github.com/openwatersio/coordinate-format.git"
  },
  "keywords": [
    "dms",
    "coordinates",
    "latitude",
    "longitude",
    "degrees",
    "minutes",
    "seconds",
    "lat",
    "lon",
    "lng"
  ],
  "author": {
    "name": "Brandon Keepers",
    "email": "brandon@openwaters.io"
  },
  "contributors": [
    "Erik Escoffier <erik.escoffier@gmail.com>",
    "Rowan Winsemius"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/openwatersio/coordinate-format/issues"
  },
  "homepage": "https://github.com/openwatersio/coordinate-format",
  "devDependencies": {
    "tsdown": "^0.20.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
